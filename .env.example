# Variables de entorno del backend. Copiar a `.env` (nunca se versiona).
#
# FIREBASE_CREDENTIALS_JSON: JSON completo de la cuenta de servicio de Firebase
# en una sola línea. Sin esta variable la API responde 503 en las rutas que
# tocan Firestore; /health sigue funcionando.
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"shareu","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@shareu.iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}

# Credencial administrativa para POST /documentos y para la bandeja de
# revisión. Si falta, esas rutas fallan cerradas con 503 (ADR 0014).
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SHAREU_ADMIN_TOKEN=cambiar-por-un-token-largo-y-aleatorio

# Orígenes permitidos por CORS, separados por coma.
SHAREU_FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# TTL de la caché de lectura en segundos (0 la apaga). Ver ADR 0013.
SHAREU_CACHE_TTL_SEGUNDOS=60

# Espera base de los reintentos del outbox en segundos (1, 2, 4...). Ver ADR 0015.
SHAREU_EVENTO_ESPERA_BASE_SEGUNDOS=1.0

# Solo para el frontend (build arg de Next.js en docker compose).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
