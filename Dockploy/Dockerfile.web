# Frontend Next.js 14 de ShareU. Contexto de build: app/frontend.
# Usa "next start" (el proyecto no define output: "standalone" ni carpeta public/).
FROM node:22-alpine AS construccion
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package*.json ./
RUN npm ci --ignore-scripts
COPY . .
# NEXT_PUBLIC_* se fija en el build: llega como build arg desde el compose.
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
# Si el build arg falta, `next build` hornearía http://127.0.0.1:8000 en el
# bundle y el navegador llamaría a su propio localhost. Fallar aquí es más claro.
RUN test -n "$NEXT_PUBLIC_API_URL" || (echo "Falta el build arg NEXT_PUBLIC_API_URL (p. ej. https://api-shareu.iscoutb.dev)" >&2; exit 1)
RUN npm run build && npm prune --omit=dev
 
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
COPY --from=construccion /app/package.json ./
COPY --from=construccion /app/node_modules ./node_modules
COPY --from=construccion /app/.next ./.next
USER node
EXPOSE 3000
CMD ["node_modules/.bin/next", "start", "-H", "0.0.0.0", "-p", "3000"]